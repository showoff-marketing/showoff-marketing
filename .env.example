# Public marketing build settings.
PUBLIC_SITE_MODE=prelaunch
PUBLIC_SITE_URL=https://showoff.marketing
PUBLIC_APP_URL=https://app.showoff.marketing
PUBLIC_WAITLIST_ENDPOINT=

# Public Supabase project values used by the customer and admin app browser clients.
# Configure real values in each environment; do not add secret/service-role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Stripe test mode. Keep this unset until test credentials are available.
STRIPE_SECRET_KEY=
