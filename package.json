{
  "name": "@showoff/workspace",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm run dev:customer",
    "dev:customer": "pnpm --filter ./apps/customer-portal --fail-if-no-match run dev",
    "dev:admin": "pnpm --filter @showoff/admin-portal --fail-if-no-match run dev",
    "dev:marketing": "pnpm --filter ./apps/marketing --fail-if-no-match run dev",
    "lint": "oxlint apps packages",
    "lint:fix": "oxlint --fix apps packages",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "pnpm run build:customer && pnpm run build:admin && pnpm run build:marketing",
    "build:customer": "pnpm --filter ./apps/customer-portal run build",
    "build:admin": "pnpm --filter @showoff/admin-portal --fail-if-no-match run build",
    "build:marketing": "pnpm --filter ./apps/marketing --fail-if-no-match run build",
    "typecheck": "pnpm run typecheck:customer && pnpm run typecheck:admin && pnpm run typecheck:marketing",
    "typecheck:customer": "pnpm --filter ./apps/customer-portal run typecheck",
    "typecheck:admin": "pnpm --filter @showoff/admin-portal run typecheck",
    "typecheck:marketing": "pnpm --filter ./apps/marketing run check",
    "test": "pnpm --filter ./apps/customer-portal run test && pnpm --filter @showoff/admin-portal run test && pnpm --filter ./apps/marketing run test",
    "test:e2e": "pnpm --filter ./apps/customer-portal run test:e2e && pnpm --filter ./apps/marketing run test:e2e",
    "test:db": "pnpm dlx supabase@2.119.0 test db --local",
    "supabase:start": "pnpm dlx supabase@2.119.0 start --exclude realtime,storage-api,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "supabase:start:full": "pnpm dlx supabase@2.119.0 start",
    "supabase:stop": "pnpm dlx supabase@2.119.0 stop --no-backup"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "**/*.{json,jsonc,md,mdx,css,scss,html,yml,yaml}": "oxfmt --write"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.8.1"
}
