{
  "name": "@showoff/workspace",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm run dev:customer",
    "dev:customer": "pnpm --filter ./apps/customer-portal --fail-if-no-match run dev",
    "dev:marketing": "pnpm --filter ./apps/marketing --fail-if-no-match run dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "pnpm run build:customer",
    "build:customer": "pnpm --filter ./apps/customer-portal run build",
    "build:marketing": "pnpm --filter ./apps/marketing --fail-if-no-match run build"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "**/*.{json,jsonc,md,mdx,css,scss,html,yml,yaml}": "oxfmt --write"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.8.1"
}
